{
    "C_Cpp.default.compilerPath": "g++.exe",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**"
    ],
    "C_Cpp.default.intelliSenseMode": "gcc-x64",
    "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 4 }",
    "files.associations": {
        "*.cpp": "cpp",
        "*.c": "c"
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.formatOnType": true,
    "editor.renderWhitespace": "boundary",
    "editor.rulers": [
        80,
        120
    ],
    "editor.wordWrap": "off",
    "editor.minimap.enabled": true,
    "editor.fontFamily": "Consolas, 'Courier New', monospace",
    "editor.fontSize": 14,
    "editor.fontLigatures": true,
    "editor.acceptSuggestionOnEnter": "on",
    "editor.codeActionsOnSave": {
        "source.organizeImports": true,
        "source.fixAll": true
    },
    "files.autoSave": "onFocusChange",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "git.autofetch": true,
    "workbench.colorTheme": "Default Dark+",
    "workbench.iconTheme": "vscode-icons",
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "[c]": {
        "editor.defaultFormatter": "xaver.clang-format"
    }
    ,
    "terminal.integrated.confirmOnExit": true,
    "code-runner.runInTerminal": false,
    "code-runner.clearPreviousOutput": false,
    "code-runner.executorMap": {
        "cpp": "g++ -std=c++17 \"$fileName\" -o \"$fileDir\\$fileNameWithoutExt.exe\" && powershell -NoExit -Command \"& '$fileDir\\$fileNameWithoutExt.exe'; Read-Host 'Press Enter to exit...'\"",
        "c": "gcc -std=c11 \"$fileName\" -o \"$fileDir\\$fileNameWithoutExt.exe\" && powershell -NoExit -Command \"& '$fileDir\\$fileNameWithoutExt.exe'; Read-Host 'Press Enter to exit...'\""
    }
}
